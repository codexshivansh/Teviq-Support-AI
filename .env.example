PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://demo-client-site.com,https://teviq-support-ai-dashboard-ph9p.vercel.app,https://teviq.in,https://www.teviq.in

# Gemini network calls are disabled; knowledge retrieval is local lexical search.

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

CLERK_SECRET_KEY=your_clerk_secret_key
ENABLE_DEMO_LOGIN=false

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_KNOWLEDGE_BUCKET=knowledge-documents
SHOPIFY_CREDENTIALS_SECRET=use_a_long_random_secret_for_shopify_token_encryption
SHOPIFY_CLIENT_ID=your_shopify_app_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_app_client_secret
SHOPIFY_SCOPES=read_products,read_orders,read_fulfillments
SHOPIFY_ADMIN_API_VERSION=2026-07
SHOPIFY_REDIRECT_URI=https://teviq-support-ai-backend.onrender.com/api/integrations/shopify/oauth/callback
PUBLIC_API_URL=https://teviq-support-ai-backend.onrender.com
DASHBOARD_URL=https://dashboard.teviq.in
SHOPIFY_PRODUCT_SYNC_MAX_PAGES=50
SHOPIFY_ORDER_SYNC_MAX_PAGES=20

TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# WhatsApp Cloud API webhook verification token. This is user-chosen (not issued
# by Meta) — pick any long random string and enter the same value into the
# Meta App Dashboard's webhook configuration.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=choose_a_long_random_string
WHATSAPP_APP_ID=your_meta_app_id
WHATSAPP_APP_SECRET=your_meta_app_secret
WIDGET_SESSION_SECRET=replace_with_a_random_secret_at_least_32_bytes_long
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=your_facebook_login_for_business_config_id
WHATSAPP_GRAPH_API_VERSION=v21.0

# Leave blank until a signed callback from the configured Instagram app has
# verified this exact seen-event shape. Supported verified value: read_mid_v1.
INSTAGRAM_SEEN_WEBHOOK_FORMAT=

INTERNAL_CRON_SECRET=use_a_long_random_secret_for_the_internal_cron_endpoint
